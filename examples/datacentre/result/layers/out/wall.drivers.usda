#usda 1.0
(
    customLayerData = {
        string "aeco:wall:layer" = "drivers"
        string "aeco:wall:producer" = "aeco-wall 0.2.5"
        string "aeco:wall:sectionEvidence" = "equivalent single layer from reported SI width; materials and priorities unknown"
    }
    defaultPrim = "demo_datacentre_01"
    fallbackPrimTypes = {
        token[] AecoFacility = ["Xform"]
        token[] AecoFacilityPart = ["Xform"]
        token[] AecoLevel = ["Xform"]
        token[] AecoPort = ["Xform"]
        token[] AecoSite = ["Xform"]
        token[] AecoSpace = ["Xform"]
        token[] AecoSystem = ["Scope"]
        token[] AecoZone = ["Scope"]
    }
    metersPerUnit = 1
    subLayers = [
        @wall.drivers.derived.usda@,
        @../../../inputs/source/dist/clash/dc.usda@
    ]
    upAxis = "Z"
)

over "demo_datacentre_01"
