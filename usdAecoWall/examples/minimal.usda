            def Xform "Main" (
                prepend apiSchemas = ["AecoElementAPI", "AecoClassificationAPI:ifc", "AecoWallAPI", "AecoAxisAPI"]
                prepend inherits = </_TypeCatalog/LayeredWall>
            )
            {
                double3 aeco:axis:end = (4, 0, 0)
